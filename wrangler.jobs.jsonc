{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canwoo-research",
  "account_id": "bf045b2b8a84caff86b86f4952486119",
  "main": "workers/research.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canwoo",
      "database_id": "689a6ad8-2a97-4640-a780-b2378ff9d394",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "canwoo-originals" }],
  "queues": {
    "producers": [{ "binding": "JOB_QUEUE", "queue": "canwoo-research" }],
    "consumers": [
      {
        "queue": "canwoo-research",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1,
      },
    ],
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "redact_query_string": true },
  "limits": { "cpu_ms": 30000 },
}
