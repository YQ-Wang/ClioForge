{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canwoo",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canwoo",
      // Local placeholder. Copy this file to an ignored *.local.jsonc file
      // and set your own database ID before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "canwoo-originals",
    },
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "BETTER_AUTH_URL": "http://127.0.0.1:3000",
    "EMAIL_FROM": "noreply@example.com",
  },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["noreply@example.com"] },
  ],
  "limits": {
    "cpu_ms": 30000,
  },
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "canwoo-research",
      },
    ],
  },
}
