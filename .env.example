# Copy to .dev.vars for local Workers development. Use Cloudflare secrets in production.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate each secret separately: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
BETTER_AUTH_SECRET=
FOLIOTRACE_ENCRYPTION_KEY=
# Localhost only. Never disables verification for a public hostname.
AUTH_ALLOW_UNVERIFIED_LOCAL=1
# Cloudflare EMAIL binding + verified sending domain (Workers Paid for new users).
# Local development does not send real email unless its binding is explicitly remote.
EMAIL_FROM=

# Google Drive: same Google Cloud project; see docs/cloud-drive-setup.md.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Restricted browser key and numeric project number (public Picker configuration).
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Optional public contact for YOUR installation (shown on /privacy).
INSTANCE_CONTACT_EMAIL=
